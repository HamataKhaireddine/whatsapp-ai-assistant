# ---------------------------------------------------------------
# Copy to .env and fill in. Everything is optional: with no
# OPENAI_API_KEY the app runs in offline mock mode.
# ---------------------------------------------------------------

# --- LLM -------------------------------------------------------
# "openai" (any OpenAI-compatible API) or "mock" (offline, rule-based).
# Defaults to "openai" when OPENAI_API_KEY is set, otherwise "mock".
LLM_PROVIDER=
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint works, e.g.
#   https://api.openai.com/v1      (OpenAI, default)
#   https://openrouter.ai/api/v1   (OpenRouter)
#   https://api.groq.com/openai/v1 (Groq)
#   http://localhost:11434/v1      (Ollama, local)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000

# --- Server ----------------------------------------------------
PORT=3000
BUSINESS_NAME=Pawsome Pet Supplies

# --- WhatsApp Cloud API ----------------------------------------
# Leave WHATSAPP_ACCESS_TOKEN empty to log outgoing messages
# instead of sending them (mock mode).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; must match the one entered in the Meta dashboard.
WHATSAPP_VERIFY_TOKEN=change-me
# App secret used to verify X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
