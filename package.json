{
  "name": "whatsapp-ai-assistant",
  "version": "1.0.0",
  "description": "LLM-powered customer assistant for WhatsApp and the web: product search, Q&A and appointment booking via function calling. Runs fully offline in mock mode.",
  "license": "MIT",
  "author": "Hamata Khair Eddine <hamatakhaireddine@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "chat": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts"
  },
  "keywords": ["whatsapp", "chatbot", "llm", "openai", "function-calling", "tool-use", "ai-agent", "typescript"],
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
